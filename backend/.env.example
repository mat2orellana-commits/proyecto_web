# ============================================================
# Sakura Player — Backend (copiar a .env y ajustar)
# ============================================================

# Escucha del backend
# Local: 127.0.0.1 (solo tu máquina). En Render/la nube: 0.0.0.0
# (o usá el backend/Procfile, que ya pasa --host 0.0.0.0 --port $PORT).
SAKURA_HOST=127.0.0.1
SAKURA_PORT=8000

# Orígenes permitidos por CORS (separados por coma).
# OJO: si creás .env, este valor REEMPLAZA a la lista por defecto del
# código — incluí todos los orígenes desde los que sirvás la app.
# Además SIEMPRE se permite cualquier puerto local (localhost/127.0.0.1
# con cualquier puerto). Si el origen no está permitido, el navegador
# bloquea la petición y el reproductor muestra "Backend apagado o sin
# conexión".
SAKURA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://lemichiw-cyber.github.io,https://proyecto-web-2-bygl.onrender.com

# YouTube Music — archivo de autenticación (NUNCA se commitea).
# Generarlo con:
#   python -c "from ytmusicapi import YTMusic; YTMusic().setup()"
# o, para OAuth:
#   python -c "from ytmusicapi import YTMusic; YTMusic(auth='oauth.json').setup()"
# Si no existe, el backend funciona en modo invitado (búsqueda y streaming).
YTMUSIC_AUTH_FILE=auth.json

# Modo invitado aunque exista auth.json (true/false)
YTMUSIC_ALLOW_ANONYMOUS=true
